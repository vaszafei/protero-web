# ================================================
# DATABASE CONFIGURATION
# ================================================

# Supabase (NEW - Primary Database)
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Database Direct Connection (for Python/ML services)
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres


# ================================================
# AUTHENTICATION & SECURITY
# ================================================

# Admin Panel Password (change this!)
ADMIN_PASSWORD=your_secure_password_here

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here
